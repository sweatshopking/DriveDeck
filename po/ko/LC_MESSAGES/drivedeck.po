msgstr "{} 폴더를 백업할 수 없습니다: {}"

msgid "{} doesn't exist."
msgstr "{}이(가) 없습니다."

msgid "{} is already a link to somewhere else, so it's left alone."
msgstr "{}은(는) 이미 다른 위치를 가리키는 링크이므로 변경하지 않습니다."

