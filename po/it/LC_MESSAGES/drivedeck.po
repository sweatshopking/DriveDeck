msgstr "Quando sincronizzare"

#: ui/app.slint:1766
msgid "Full check every"
msgstr "Controllo completo ogni"

#: ui/app.slint:1771
msgid "How often to check for changes"
msgstr "Ogni quanto controllare le modifiche"

#: ui/app.slint:1772
msgid "5 minutes"
msgstr "5 minuti"

#: ui/app.slint:1772
