#: ui/app.slint:2313
msgid "SharePoint site address or name"
msgstr "Indirizzo o nome del sito SharePoint"

#: ui/app.slint:2316
msgid "Paste the site's address, or type part of its name"
msgstr "Incolla l’indirizzo del sito o scrivi parte del nome"

#: ui/app.slint:2322
msgid "Find"
