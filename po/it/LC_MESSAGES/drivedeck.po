msgid ""
"Best to pick an empty or new folder. Anything already in it will be uploaded."
msgstr "È meglio scegliere una cartella vuota o nuova. Tutto ciò che contiene verrà caricato."

#: ui/app.slint:2422 ui/app.slint:2427
msgid "Microsoft cloud"
msgstr "Cloud Microsoft"

#: ui/app.slint:2428
