#: ui/app.slint:2505
msgid ""
"Syncing itself keeps running in the background either way. The tray icon "
"shows status and runs sync schedules."
msgstr "A sincronização continua em segundo plano de qualquer forma. O ícone na bandeja mostra o status e executa os horários de sincronização."

#: ui/app.slint:2508
msgid "Stop syncing when I quit the tray icon"
msgstr "Parar a sincronização quando eu fechar o ícone na bandeja"

#: ui/app.slint:2515
msgid ""
