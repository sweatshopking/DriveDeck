msgid "When to sync"
msgstr "Quando sincronizar"

#: ui/app.slint:1766
msgid "Full check every"
msgstr "Verificação completa a cada"

#: ui/app.slint:1771
msgid "How often to check for changes"
msgstr "Com que frequência verificar alterações"

#: ui/app.slint:1772
msgid "5 minutes"
msgstr "5 minutos"

#: ui/app.slint:1772
msgid "10 minutes"
msgstr "10 minutos"

#: ui/app.slint:1772
