msgid "Sync everything"
msgstr "Sincronizar tudo"

#: ui/app.slint:1636
msgid ""
"Every folder in this account is kept on this computer. Untick to choose "
"specific folders."
msgstr "Todas as pastas desta conta ficam neste computador. Desmarque para escolher pastas específicas."

#: ui/app.slint:1636
msgid ""
"Only the ticked folders (and everything inside them) are kept on this "
"computer."
msgstr "Somente as pastas marcadas (e tudo dentro delas) ficam neste computador."

#: ui/app.slint:1639
msgid "Also sync files that sit at the top level (outside any folder)"
msgstr "Sincronizar também arquivos que ficam no nível principal (fora de qualquer pasta)"

#: ui/app.slint:1657
msgid "Loading subfolders for "
msgstr "Carregando subpastas de "

