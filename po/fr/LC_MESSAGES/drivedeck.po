msgstr "La version publiée n’indique pas de somme de contrôle pour {} ; elle n’a donc pas été installée."

#: src/update.rs
msgid "This copy can't update itself; the download page is open: {}"
msgstr "Cette copie ne peut pas se mettre à jour elle-même ; la page de téléchargement est ouverte : {}"

#: src/update.rs
msgid "This is the newest version."
msgstr "C’est la version la plus récente."

#: src/update.rs
msgid "Update now"
msgstr "Mettre à jour"

#: src/update.rs
msgid "Update to version {} now"
msgstr "Mettre à jour vers la version {}"

#: src/update.rs
msgid "Updated to version {}."
msgstr "Mis à jour vers la version {}."

#: src/update.rs
msgid "Version {} is installed. The tray icon restarts on it by itself; reopen any DriveDeck window that was open."
msgstr "La version {} est installée. L’icône de la zone de notification redémarre dessus d’elle-même ; rouvrez les fenêtres DriveDeck qui étaient ouvertes."

#: src/update.rs
msgid "Version {} of this app is available. Click the OneDrive tray icon (or right-click it) and choose Update."
msgstr "La version {} de cette application est disponible. Cliquez sur l’icône OneDrive de la zone de notification (ou faites un clic droit) et choisissez Mettre à jour."

