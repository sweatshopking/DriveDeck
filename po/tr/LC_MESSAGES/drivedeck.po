msgid "↺ Reset to default"
msgstr "↺ Varsayılana sıfırla"

#: ui/app.slint:2170
msgid "No setting matches \""
msgstr "Şu ayarla eşleşen sonuç yok: \""

#: ui/app.slint:2177
msgid "Show all settings in use"
msgstr "Kullanılan tüm ayarları göster"

#: ui/app.slint:2183
msgid "Open log folder"
msgstr "Günlük klasörünü aç"

#: ui/app.slint:2203
msgid "Save"
msgstr "Kaydet"

#: ui/app.slint:2220
msgid "When"
msgstr "Ne zaman"

#: ui/app.slint:2220
msgid "What"
msgstr "Ne"

#: ui/app.slint:2220
msgid "File"
msgstr "Dosya"

#: ui/app.slint:2227
msgid "Recent uploads, downloads and deletions from the sync log."
msgstr "Eşitleme günlüğündeki son yüklemeler, indirmeler ve silmeler."

#: ui/app.slint:2232
msgid "Show in folder"
msgstr "Klasörde göster"

#: ui/app.slint:2239
msgid "Refresh"
msgstr "Yenile"

#: ui/app.slint:2256
msgid "Welcome — let's add your OneDrive"
msgstr "Hoş geldiniz — OneDrive'ınızı ekleyelim"

#: ui/app.slint:2256
msgid "Add an account"
msgstr "Hesap ekle"

#: ui/app.slint:2261
msgid "What would you like to sync?"
msgstr "Neleri eşitlemek istiyorsunuz?"

#: ui/app.slint:2265 ui/app.slint:3581 ui/app.slint:3670
msgid "OneDrive"
msgstr "OneDrive"

#: ui/app.slint:2266
msgid ""
"A personal Microsoft account (Outlook, Hotmail, Live) or a work or school "
"account."
msgstr "Kişisel Microsoft hesabı (Outlook, Hotmail, Live) veya iş ya da okul hesabı."

#: ui/app.slint:2273
msgid "SharePoint library"
msgstr "SharePoint kitaplığı"

#: ui/app.slint:2274
msgid ""
"A document library from a SharePoint or Teams site. You'll need a work or "
"school account added first."
msgstr "SharePoint veya Teams sitesindeki belge kitaplığı. Önce bir iş ya da okul hesabı eklemeniz gerekir."

#: ui/app.slint:2288
msgid "1. Find the library"
msgstr "1. Kitaplığı bulun"

#: ui/app.slint:2293
msgid "Using account"
msgstr "Hesap"

#: ui/app.slint:2298
msgid "Work or school account for this library"
msgstr "Bu kitaplık için iş veya okul hesabı"

#: ui/app.slint:2308
msgid "Site"
msgstr "Site"

#: ui/app.slint:2313
msgid "SharePoint site address or name"
msgstr "SharePoint site adresi veya adı"

#: ui/app.slint:2316
msgid "Paste the site's address, or type part of its name"
msgstr "Sitenin adresini yapıştırın veya adının bir kısmını yazın"

#: ui/app.slint:2322
msgid "Find"
msgstr "Bul"

#: ui/app.slint:2330
msgid ""
"Copy the address from your browser while viewing the SharePoint site or "
"library. Leave it empty to list the sites you belong to — only sites this "
"account can already open appear."
msgstr "SharePoint sitesini veya kitaplığını görüntülerken adresi tarayıcınızdan kopyalayın. Boş bırakırsanız üyesi olduğunuz siteler listelenir — yalnızca bu hesabın zaten açabildiği siteler görünür."

#: ui/app.slint:2383
msgid "2. Where to keep it"
msgstr "2. Saklanacağı yer"

#: ui/app.slint:2383
msgid "Name and folder"
msgstr "Ad ve klasör"

#: ui/app.slint:2395
msgid "e.g. Personal, Work"
msgstr "ör. Kişisel, İş"

#: ui/app.slint:2401
msgid "Local folder"
msgstr "Yerel klasör"

#: ui/app.slint:2406
msgid "Local folder for synced files"
msgstr "Eşitlenen dosyalar için yerel klasör"

#: ui/app.slint:2410
msgid "Browse…"
msgstr "Göz at…"

#: ui/app.slint:2417
