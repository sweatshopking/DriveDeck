msgstr "Downloads niet controleren"


msgid "Don't check for new client versions"
msgstr "Niet controleren op nieuwe versies van de client"


msgid "Don't check uploads"
msgstr "Uploads niet controleren"


msgid "Don't get instant online changes"
msgstr "Geen directe online wijzigingen ophalen"


msgid "Don't set permissions on downloaded files"
